{
  "problemMatcher": [
    {
      "owner": "c-compiler",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(error|warning):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "build-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^(.*(?:undefined reference to|ld returned|ld: |cannot find|No such file or directory|No rule to make target|makeinfo:|\\*\\*\\* \\[.*\\] Error \\d+).*)$",
          "message": 1
        }
      ]
    }
  ]
}
